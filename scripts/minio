sudo umount minio-data
set -e
rm -rf minio-data
rm -f minio.img
dd if=/dev/zero of=minio.img bs=1M count=1024
mkfs.ext4 minio.img
mkdir -p minio-data
sudo mount -o loop minio.img minio-data

docker run --rm \
  --name minio \
  -v $(pwd)/minio-data:/data \
  -p 9000:9000 \
  -p 9001:9001 \
  -e MINIO_ROOT_USER=minioadmin \
  -e MINIO_ROOT_PASSWORD=minioadmin \
  quay.io/minio/minio server /data --console-address ":9001"